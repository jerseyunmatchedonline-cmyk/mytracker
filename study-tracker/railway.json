{
  "$schema": "https://schemas.railway.com/railway-docker-compose.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "nodeVersion": "20"
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicy": "ON_FAILURE",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  },
  "environmentVariables": {
    "SESSION_SECRET": {
      "description": "Secret key for session signing"
    }
  }
}